{
  "name": "@budget/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "smoke": "tsx src/scripts/smoke-dnd.ts",
    "dev-init-data": "tsx src/scripts/dev-init-data.ts",
    "bot": "tsx src/bot/index.ts",
    "worker": "tsx src/workers/index.ts",
    "smoke:alerts": "REDIS_NAMESPACE=finapp-smoke tsx src/scripts/smoke-alerts.ts",
    "smoke:profiles": "REDIS_NAMESPACE=finapp-smoke tsx src/scripts/smoke-profiles.ts",
    "smoke:limits": "REDIS_NAMESPACE=finapp-smoke tsx src/scripts/smoke-limits.ts",
    "smoke:bot": "tsx src/scripts/smoke-bot.ts",
    "smoke:settings": "REDIS_NAMESPACE=finapp-smoke tsx src/scripts/smoke-settings.ts",
    "smoke:crud": "tsx src/scripts/smoke-crud.ts"
  },
  "dependencies": {
    "@budget/shared": "*",
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "grammy": "^1.45.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
