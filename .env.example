# ─── Copy to apps/api/.env and fill real values. NEVER commit the real .env ───

# App
NODE_ENV=development
API_PORT=3000

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=budget_manager
PGUSER=budget
PGPASSWORD=change_me
DATABASE_URL=postgresql://budget:change_me@127.0.0.1:5432/budget_manager

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Telegram
TELEGRAM_BOT_TOKEN=put_bot_token_here
TELEGRAM_BOT_USERNAME=bugetmanagementbot

# Web (Mini App) — public URL used by bot web_app button (needs HTTPS in production)
WEB_APP_URL=http://localhost:5173
